#!/bin/bash
# Claude Board - Daemon management script

set -e

# Resolve the script's actual location (handles symlinks)
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "${SCRIPT_PATH}")"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
SERVICE_NAME="claude-board"
SERVICE_FILE="${HOME}/.config/systemd/user/${SERVICE_NAME}.service"
LOG_DIR="${HOME}/.local/share/claude-board"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Ensure log directory exists
mkdir -p "${LOG_DIR}"

# Helper functions
log_error() {
    echo -e "${RED}❌ Error: $1${NC}" >&2
}

log_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

log_info() {
    echo -e "${YELLOW}ℹ️  $1${NC}"
}

check_bun() {
    if ! command -v bun &> /dev/null; then
        log_error "Bun is not installed. Please install Bun first."
        exit 1
    fi
}

install_dependencies() {
    log_info "Installing dependencies..."
    cd "${PROJECT_ROOT}"
    bun install
    log_success "Dependencies installed"
}

create_service_file() {
    # Create systemd user directory if it doesn't exist
    mkdir -p "${HOME}/.config/systemd/user"

    # Get bun path
    local BUN_PATH=$(command -v bun)

    # Use PORT env var or default to 3000
    local PORT=${PORT:-3000}

    # Create the service file with variable expansion
    cat > "${SERVICE_FILE}" << EOF
[Unit]
Description=Claude Board - Web UI for Claude CLI
After=network.target

[Service]
Type=simple
WorkingDirectory=${PROJECT_ROOT}
Environment="PORT=${PORT}"
ExecStart=${BUN_PATH} ${PROJECT_ROOT}/src/server.ts
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-board

[Install]
WantedBy=default.target
EOF

    log_success "Service file created at ${SERVICE_FILE} (PORT=${PORT})"
}

enable_service() {
    log_info "Enabling systemd user service..."
    systemctl --user daemon-reload
    systemctl --user enable "${SERVICE_NAME}.service"
    log_success "Service enabled"
}

cmd_install() {
    log_info "Installing Claude Board as daemon..."
    check_bun

    # Check if already installed
    if systemctl --user is-enabled "${SERVICE_NAME}.service" &> /dev/null; then
        log_info "Service is already installed. Use 'start' to start it."
        return
    fi

    install_dependencies
    create_service_file
    enable_service

    log_success "Installation complete!"
    echo ""
    echo "Next steps:"
    echo "  1. Start the service: claude-board start"
    echo "  2. Check status: claude-board status"
    echo "  3. View logs: journalctl --user -u ${SERVICE_NAME} -f"
}

cmd_start() {
    log_info "Starting Claude Board..."
    check_bun

    if ! systemctl --user is-enabled "${SERVICE_NAME}.service" &> /dev/null; then
        log_error "Service is not installed. Run 'claude-board install' first."
        exit 1
    fi

    systemctl --user start "${SERVICE_NAME}.service"
    sleep 1

    if systemctl --user is-active "${SERVICE_NAME}.service" &> /dev/null; then
        log_success "Service started successfully"
        echo ""
        echo "Access the UI at: http://localhost:3000"
        echo "View logs: journalctl --user -u ${SERVICE_NAME} -f"
    else
        log_error "Failed to start service"
        journalctl --user -u "${SERVICE_NAME}" -n 10 --no-pager
        exit 1
    fi
}

cmd_stop() {
    log_info "Stopping Claude Board..."

    if ! systemctl --user is-enabled "${SERVICE_NAME}.service" &> /dev/null; then
        log_error "Service is not installed."
        exit 1
    fi

    systemctl --user stop "${SERVICE_NAME}.service"
    log_success "Service stopped"
}

cmd_restart() {
    log_info "Restarting Claude Board..."
    cmd_stop
    sleep 1
    cmd_start
}

cmd_status() {
    if ! systemctl --user is-enabled "${SERVICE_NAME}.service" &> /dev/null; then
        log_error "Service is not installed"
        return 1
    fi

    if systemctl --user is-active "${SERVICE_NAME}.service" &> /dev/null; then
        log_success "Service is running"
        echo ""
        echo "UI: http://localhost:3000"
    else
        log_info "Service is installed but not running"
        echo ""
        echo "Start with: claude-board start"
    fi

    echo ""
    systemctl --user status "${SERVICE_NAME}.service" --no-pager || true
}

cmd_logs() {
    if ! systemctl --user is-enabled "${SERVICE_NAME}.service" &> /dev/null; then
        log_error "Service is not installed"
        exit 1
    fi

    journalctl --user -u "${SERVICE_NAME}" -f "$@"
}

cmd_uninstall() {
    log_info "Uninstalling Claude Board daemon..."

    if systemctl --user is-active "${SERVICE_NAME}.service" &> /dev/null; then
        systemctl --user stop "${SERVICE_NAME}.service"
    fi

    systemctl --user disable "${SERVICE_NAME}.service"
    systemctl --user daemon-reload

    if [ -f "${SERVICE_FILE}" ]; then
        rm "${SERVICE_FILE}"
    fi

    log_success "Service uninstalled"
}

show_help() {
    cat << EOF
Claude Board - Daemon Management

Usage: claude-board <command> [options]

Commands:
  install              Install as systemd user service and enable
  start                Start the service
  stop                 Stop the service
  restart              Restart the service
  status               Show service status
  logs [options]       Show service logs (pass -f for follow)
  uninstall            Remove the service
  help                 Show this help message

Examples:
  claude-board install
  claude-board start
  claude-board status
  claude-board logs -f
  claude-board restart

Environment:
  Service logs: journalctl --user -u claude-board -f
  Service file: ${HOME}/.config/systemd/user/claude-board.service
  Log directory: ${LOG_DIR}

EOF
}

# Main command dispatcher
COMMAND="${1:-help}"

case "${COMMAND}" in
    install)
        cmd_install
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    logs)
        shift
        cmd_logs "$@"
        ;;
    uninstall)
        cmd_uninstall
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        log_error "Unknown command: ${COMMAND}"
        echo ""
        show_help
        exit 1
        ;;
esac
